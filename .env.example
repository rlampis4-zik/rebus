# Runtime: connection string POOLED (host con "-pooler")
DATABASE_URL=

# Migrazioni e script admin: connection string DIRETTA (senza "-pooler")
DATABASE_URL_UNPOOLED=

# Solo per lo script admin. Generare con: openssl rand -hex 32
# NON va messa fra le env di Vercel: il backend non cifra nulla a runtime.
REBUS_ENC_KEY=

# Opzionali
CACHE_S_MAXAGE=3600
CACHE_SWR=86400
